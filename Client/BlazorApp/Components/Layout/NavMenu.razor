@using BlazorApp.Auth
@inject SimpleAuthProvider AuthProvider
@inject NavigationManager Navigation

<div class="nav-scrollable">
    <nav class="flex-column">

        <AuthorizeView>
            <Authorized Context="authContext">
                <div class="nav-item px-3">
                    <span class="nav-link">
                        Logget ind som: @authContext.User.Identity?.Name
                    </span>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        Home
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="createpost">
                        Create post
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <button class="btn btn-link nav-link" @onclick="Logout">
                        Log ud
                    </button>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        Login
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="createuser">
                        Create user
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private void Logout()
    {
        AuthProvider.Logout();
        Navigation.NavigateTo("/login");
    }
}